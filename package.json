{
  "name": "time-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "node git-version-gen.js && ng build --configuration production,pages",
    "prepare": "node git-version-gen.js",
    "prebuild": "node git-version-gen.js",
    "postbuild": "gzipper compress --gzip-level=9 --include js,json,css,html ./dist",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage --coverage-reporters=text --coverage-reporters=lcov --coverage-reporters=html",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint && npm run format && npm test && npm run e2e && npm run build",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:vrt": "VRT=1 playwright test",
    "e2e:vrt:baseline": "VRT=1 playwright test --update-snapshots",
    "e2e:vrt:report": "playwright show-report",
    "e2e:vrt:docker": "./scripts/vrt-docker.sh",
    "e2e:vrt:baseline:docker": "./scripts/vrt-docker.sh baseline"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/material-moment-adapter": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/service-worker": "^22.1.5",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/material-icons": "^5.3.0",
    "@ng-matero/extensions": "^22.0.0",
    "@ng-matero/extensions-moment-adapter": "^22.0.0",
    "@ngrx-toolkit/core": "^22.0.1",
    "@ngrx/signals": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@typescript-eslint/utils": "^8.69.0",
    "chart.js": "^4.5.1",
    "events": "^3.3.0",
    "firebase": "^12.18.0",
    "moment": "^2.30.1",
    "ng2-charts": "^10.0.0",
    "pouchdb-browser": "^8.0.1",
    "pouchdb-find": "^8.0.1",
    "rxjs": "^7.5.7",
    "tslib": "^2.6.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.2.0",
    "@angular-eslint/eslint-plugin-template": "^22.2.0",
    "@angular-eslint/template-parser": "^22.2.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@ngrx/schematics": "^22.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/pouchdb-browser": "^6.1.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "git-rev-sync": "^3.0.2",
    "gzipper": "^8.3.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
